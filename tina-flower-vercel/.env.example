# Public URL after deployment, e.g. https://tina-flower.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. If empty, the bundled static poster is shown until you add the downloaded video under public/videos/hero-desktop.mp4
# Current Higgsfield-generated 1080p hero video is hosted at this source URL. Self-host the file for reliable production use.
NEXT_PUBLIC_HERO_VIDEO_URL=https://d2ol7oe51mr4n9.cloudfront.net/user_3MHCvg3WmNVPZ7oePdns6p0iGyl/7d71c03d-2380-43a1-83f3-662f4b3bb7a4.mp4
# Configure one or both delivery methods below before accepting real inquiries.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional distributed request throttling
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
